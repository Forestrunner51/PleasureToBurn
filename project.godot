; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pleasure to Burn"
config/description="Job simulator prototype: a fireman in a world where books are banned. Fire system + flamethrower slice."
run/main_scene="res://scenes/world/world.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/EventBus.cs"
FireSystem="*res://systems/fire/FireSystem.cs"
Career="*res://autoload/Career.cs"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="PleasureToBurn"

