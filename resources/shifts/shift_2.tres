[gd_resource type="Resource" script_class="ShiftConfig" load_steps=8 format=3]

[ext_resource type="Script" path="res://resources/ShiftConfig.cs" id="1_shift_config"]
[ext_resource type="Script" path="res://resources/BookData.cs" id="2_book_data"]
[ext_resource type="Resource" path="res://resources/books/poems.tres" id="3_poems"]
[ext_resource type="Resource" path="res://resources/books/almanac.tres" id="4_almanac"]
[ext_resource type="Resource" path="res://resources/books/cookbook.tres" id="5_cookbook"]
[ext_resource type="Resource" path="res://resources/books/atlas.tres" id="6_atlas"]
[ext_resource type="Resource" path="res://resources/books/clocks.tres" id="7_clocks"]

[resource]
script = ExtResource("1_shift_config")
ShiftName = "Night Shift"
Quota = 14
DurationSeconds = 90.0
RestockSeconds = 2.5
BookPool = Array[ExtResource("2_book_data")]([ExtResource("3_poems"), ExtResource("4_almanac"), ExtResource("5_cookbook"), ExtResource("6_atlas"), ExtResource("7_clocks")])
