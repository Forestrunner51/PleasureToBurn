[gd_resource type="Resource" script_class="ShiftConfig" load_steps=8 format=3]

[ext_resource type="Script" path="res://resources/ShiftConfig.cs" id="1_shift_config"]
[ext_resource type="Script" path="res://resources/BookData.cs" id="2_book_data"]
[ext_resource type="Resource" path="res://resources/books/almanac.tres" id="3_almanac"]
[ext_resource type="Resource" path="res://resources/books/cookbook.tres" id="4_cookbook"]
[ext_resource type="Resource" path="res://resources/books/atlas.tres" id="5_atlas"]
[ext_resource type="Resource" path="res://resources/books/clocks.tres" id="6_clocks"]
[ext_resource type="Resource" path="res://resources/books/weather.tres" id="7_weather"]

[resource]
script = ExtResource("1_shift_config")
ShiftName = "Overtime"
Quota = 22
DurationSeconds = 100.0
RestockSeconds = 2.0
BookPool = Array[ExtResource("2_book_data")]([ExtResource("3_almanac"), ExtResource("4_cookbook"), ExtResource("5_atlas"), ExtResource("6_clocks"), ExtResource("7_weather")])
